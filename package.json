{
  "name": "cresflo-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prebuild": "prisma generate",
    "precheck": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:setup": "node --experimental-strip-types src/scripts/setup-advisor-db.ts",
    "db:seed:norri": "npm run build && node dist/scripts/seed-norri-demo.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "openai": "^7.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "prisma": "^7.9.1",
    "redis": "^6.2.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
